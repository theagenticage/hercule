{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  // oxfmt sorts the keys of package.json by default, which prettier never did.
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "pnpm-lock.yaml",
    "packages/home/src/version.ts",
    "apps/controller/src/http/bundle.ts",
    "apps/web/src/routeTree.gen.ts",
    "apps/desktop/src/renderer/routeTree.gen.ts",
    "apps/runner/src/harnesses/codex/generated/",
    ".playwright-cli",
    // The Android app's Gradle state and build output.
    "apps/android/.gradle/",
    "apps/android/**/build/",
    // Generated by scripts/gen-markdown-parity-fixtures.ts, one case per line.
    "apps/android/app/src/test/resources/markdown/parity.json",
    // Copied unchanged from the design system, which is its source (spec 17).
    "apps/desktop/src/renderer/styles/tokens.css",
    // The Crew Bureau design book and the two folders its pages link to,
    // shared/ and c0-crew/, copied byte for byte from the design prototype
    // (spec 17). Reformatting them would make them differ from the book they
    // copy.
    "docs/design/",
    // Markdown is written by hand; reformatting the spec would bury real diffs.
    "**/*.md"
  ]
}
