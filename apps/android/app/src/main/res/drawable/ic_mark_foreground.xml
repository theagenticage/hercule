<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's foreground: the Hercule mark in colour, sized as on the book's app icon
     tile (docs/design/crew-bureau-2/system.css, .app-icon). There the mark's 32-unit box fills 64%
     of the tile. A launcher shows the middle 72dp of the 108dp canvas, so the box is 46.08dp:
     a viewport of 75 units at 108dp gives 1.44dp per unit, and the box sits 21.5 units in from
     each edge. The egg reaches 19.6dp from the centre, inside the 33dp radius of the safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="75"
    android:viewportHeight="75">
    <!-- A vector drawable takes only sRGB colours, not oklch or Display P3, so the book's colours
         are written as sRGB hex. The egg is the lime, oklch(0.78 0.125 132), and the eyes and
         mustache are the face-ink token, oklch(0.23 0.025 165), both from the Whitehaven theme in
         tokens.css. Both lie inside sRGB, so nothing is lost. -->
    <!-- The paths are the book's logo() in docs/design/crew-bureau-2/crew.js, in its 32 by 32 box:
         the egg-shaped head, two eyes (circles of radius 1.55 at 12.4,14.6 and 19.6,14.6, written
         as two arcs each) and the waxed mustache. -->
    <group
        android:translateX="21.5"
        android:translateY="21.5">
        <path
            android:fillColor="#FF99C872"
            android:pathData="M16,2.4c-6.3,0 -10.9,7.6 -10.9,14.8 0,7.1 4.8,12.4 10.9,12.4s10.9,-5.3 10.9,-12.4C26.9,10 22.3,2.4 16,2.4z" />
        <path
            android:fillColor="#FF11211A"
            android:pathData="M10.85,14.6a1.55,1.55 0,1 0,3.1 0a1.55,1.55 0,1 0,-3.1 0zM18.05,14.6a1.55,1.55 0,1 0,3.1 0a1.55,1.55 0,1 0,-3.1 0zM16,19.2c-1.5,-1.2 -3.4,-1.5 -5.1,-0.7 -0.9,0.4 -1.7,0.3 -2.3,-0.4 -0.4,-0.5 -1.2,-0.3 -1.1,0.4 0.3,1.9 2,3 4,2.8 1.8,-0.2 3.3,-0.9 4.5,-1.8 1.2,0.9 2.7,1.6 4.5,1.8 2,0.2 3.7,-0.9 4,-2.8 0.1,-0.7 -0.7,-0.9 -1.1,-0.4 -0.6,0.7 -1.4,0.8 -2.3,0.4 -1.7,-0.8 -3.6,-0.5 -5.1,0.7z" />
    </group>
</vector>
