<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon: the Hercule mark on the lacquer of the book's app icon tile. The book's
     brass ring is left out, because each launcher masks the icon into its own shape. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_mark_foreground" />
    <monochrome android:drawable="@drawable/ic_mark_monochrome" />
</adaptive-icon>
