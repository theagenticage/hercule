<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing the app stores leaves the device. The API key is encrypted under an Android
     Keystore key, which never leaves the device, so a restored copy could not be decrypted.
     Every domain is excluded by name: backup walks each domain on its own, so excluding
     `root` alone still sends `file`, where DataStore keeps the controller address and the
     alert memory. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
