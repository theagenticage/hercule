{
  "name": "@hercule/desktop",
  "productName": "Hercule",
  "version": "0.1.0",
  "description": "The Hercule desktop app for macOS.",
  "author": "Rogier Pennink",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build --config vite.renderer.config.ts && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "package": "electron-builder --mac && electron-builder --mac --config.directories.output=dist/test --config.electronFuses.enableNodeCliInspectArguments=true --config.mac.identity=null",
    "perf": "node scripts/perf.ts",
    "first-frame": "node scripts/first-frame.ts",
    "compare:bureau": "node scripts/compare-bureau.ts",
    "capture:sidebar-states": "node scripts/capture-sidebar-states.ts",
    "capture:assistant": "node scripts/capture-assistant.ts",
    "capture:room": "node scripts/capture-room.ts",
    "capture:first-run": "node scripts/capture-first-run.ts",
    "demo:subagents": "node scripts/subagents-demo.ts"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@dagrejs/dagre": "3.1.1",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@hercule/client-core": "workspace:*",
    "@hercule/contract": "workspace:*",
    "@rolldown/plugin-babel": "0.2.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-virtual": "3.14.13",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "effect": "4.0.0-rc.112",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "three": "0.186.1",
    "vite": "8.2.2"
  }
}
