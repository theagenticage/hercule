{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The perf script runs on plain Node, which resolves an import only by its
    // full file name, so it imports its neighbour as `./packaged-app.ts`.
    // TypeScript refuses that extension unless this is on.
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/ipc/**/*.ts",
    "scripts/**/*.ts",
    "container/*.ts",
    "vite.*.config.ts",
    "vitest.*.config.ts",
    // The motion, font features and tokens tests read every stylesheet of the
    // renderer with `node:fs`, the first-screen import test reads the
    // renderer's sources the same way, and each route folder's React Compiler
    // test compiles the pages' sources it reads, so all of them belong to the
    // Node program, although each sits beside the files it checks.
    // tsconfig.renderer.json leaves them out.
    "src/renderer/first-screen-mcp-imports.test.ts",
    "src/renderer/styles/motion.test.ts",
    "src/renderer/styles/fonts.test.ts",
    "src/renderer/styles/tokens.test.ts",
    "src/renderer/routes/**/react-compiler.test.ts"
  ]
}
