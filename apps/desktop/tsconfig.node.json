{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The perf script runs on plain Node, which resolves an import only by its
    // full file name, so it imports its neighbour as `./packaged-app.ts`.
    // TypeScript refuses that extension unless this is on.
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/ipc/**/*.ts",
    "scripts/**/*.ts",
    "vite.*.config.ts",
    // The motion test reads every stylesheet of the renderer with `node:fs`,
    // so it belongs to the Node program, although it sits beside the styles
    // it checks. tsconfig.renderer.json leaves it out.
    "src/renderer/styles/motion.test.ts"
  ]
}
