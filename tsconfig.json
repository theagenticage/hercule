{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    // Vite loads `vitest.config.ts` and what it imports, and asks for each
    // import's full file name, such as `./scripts/test-shards.ts`. TypeScript
    // refuses that extension unless this is on.
    "allowImportingTsExtensions": true
  },
  // Globbed, never hand-listed: a new package under apps, packages or plugins
  // is typechecked the day it lands. The two React packages, the desktop app
  // and the desktop end-to-end suite (`e2e/desktop`, which runs on Node and
  // hands functions to the app's page) carry their own tsconfigs (DOM lib,
  // JSX, Node types) and are excluded here.
  "include": [
    "apps/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "plugins/*/src/**/*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "install.test.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "eslint.config.test.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "apps/web",
    "packages/ui",
    "apps/desktop",
    "e2e/desktop"
  ]
}
