{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"]
  },
  // Globbed, never hand-listed: a new package under apps, packages or plugins
  // is typechecked the day it lands. The two React packages, the desktop app
  // and the desktop end-to-end suite (`e2e/desktop`, which runs on Node and
  // hands functions to the app's page) carry their own tsconfigs (DOM lib,
  // JSX, Node types) and are excluded here.
  "include": [
    "apps/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "plugins/*/src/**/*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "install.test.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "prettier.config.js"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "apps/web",
    "packages/ui",
    "apps/desktop",
    "e2e/desktop"
  ]
}
